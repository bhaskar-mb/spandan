{
  "$schema": "https://openapi.vercel.sh/vercel-schema.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/spandan/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/spandan/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
